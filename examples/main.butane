variant: fcos
version: 1.4.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - YOUR_SSH_PUB_KEY_HERE
      password_hash: YOUR_GOOD_PASSWORD_HASH_HERE

storage:
  directories:
    - path: /etc/globby-autorebase
      mode: 0754

systemd:
  units:
    - name: globby-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Globby autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/globby-autorebase/unverified
        ConditionPathExists=!/etc/globby-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/polyjitter/globby-main:latest
        ExecStart=/usr/bin/touch /etc/globby-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable globby-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: globby-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Globby autorebase to signed OCI and reboot
        ConditionPathExists=/etc/globby-autorebase/unverified
        ConditionPathExists=!/etc/globby-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/polyjitter/globby-main:latest
        ExecStart=/usr/bin/touch /etc/globby-autorebase/signed
        ExecStart=/usr/bin/systemctl disable globby-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target